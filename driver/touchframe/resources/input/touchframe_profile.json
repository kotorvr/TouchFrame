{
  "jsonid": "input_profile",
  "controller_type": "oculus_touch",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "touchframe",
  "driver_name": "touchframe",
  "input_bindingui_mode": "controller_handed",
  "input_bindingui_left": {
    "image": "{oculus}/icons/oculus_touch_left.svg"
  },
  "input_bindingui_right": {
    "image": "{oculus}/icons/oculus_touch_right.svg"
  },
  "should_show_binding_errors": true,
  "input_source": {
    "/input/joystick": {
      "type": "joystick",
      "click": true,
      "touch": true,
      "binding_image_point": [
        54,
        31
      ],
      "order": 2
    },
    "/input/trigger": {
      "type": "trigger",
      "value": true,
      "touch": true,
      "click": true,
      "binding_image_point": [
        22,
        85
      ],
      "order": 1
    },
    "/input/grip": {
      "type": "trigger",
      "value": true,
      "touch": true,
      "click": true,
      "binding_image_point": [
        100,
        86
      ],
      "order": 3
    },
    "/input/a": {
      "type": "button",
      "side": "right",
      "click": true,
      "touch": true,
      "binding_image_point": [
        70,
        49
      ],
      "order": 4
    },
    "/input/b": {
      "type": "button",
      "side": "right",
      "click": true,
      "touch": true,
      "binding_image_point": [
        54,
        55
      ],
      "order": 5
    },
    "/input/x": {
      "type": "button",
      "side": "left",
      "click": true,
      "touch": true,
      "binding_image_point": [
        70,
        49
      ],
      "order": 4
    },
    "/input/y": {
      "type": "button",
      "side": "left",
      "click": true,
      "touch": true,
      "binding_image_point": [
        54,
        55
      ],
      "order": 5
    },
    "/input/system": {
      "type": "button",
      "side": "left",
      "click": true,
      "touch": true,
      "binding_image_point": [
        72,
        39
      ],
      "order": 0
    },
    "/input/thumbrest": {
      "type": "button",
      "click": false,
      "touch": true,
      "binding_image_point": [
        70,
        65
      ]
    },
    "/output/haptic": {
      "type": "vibration",
      "binding_image_point": [
        72,
        39
      ]
    },
    "/pose/raw": {
      "type": "pose",
      "binding_image_point": [
        14,
        16
      ]
    },
    "/pose/base": {
      "type": "pose",
      "binding_image_point": [
        11,
        150
      ]
    },
    "/pose/handgrip": {
      "type": "pose",
      "binding_image_point": [
        24,
        86
      ]
    },
    "/pose/tip": {
      "type": "pose",
      "binding_image_point": [
        14,
        16
      ]
    },
    "/pose/openxr_aim": {
      "type": "pose",
      "binding_image_point": [
        14,
        16
      ]
    },
    "/pose/openxr_grip": {
      "type": "pose",
      "binding_image_point": [
        24,
        86
      ]
    }
  },
  "mirror_mappings": [
    [
      "/user/hand/left/input/x",
      "/user/hand/right/input/a"
    ],
    [
      "/user/hand/left/input/y",
      "/user/hand/right/input/b"
    ]
  ],
  "default_bindings": [
    {
      "app_key": "openvr.component.vrcompositor",
      "binding_url": "{oculus}/input/vrcompositor_bindings_touch.json"
    }
  ]
}